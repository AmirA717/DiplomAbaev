datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}


enum UserRole {
  USER
  ADMIN
}

enum MaterialType {
  TEXT
  VIDEO
  LINK
}

enum QuestionType {
  SINGLE
  MULTIPLE
  TRUE_FALSE
}

enum GameType {
  QUIZ_SIMULATION
  PHISHING_DETECTOR
  PASSWORD_STRENGTH
  SOCIAL_NETWORK_SCENARIO
  MFA_CHALLENGE
  UPDATE_TRIAGE
  BACKUP_STRATEGY
  SAFE_DOWNLOADS
  APP_PERMISSION_AUDIT
}

model School {
  id          Int     @id @default(autoincrement())
  name        String
  city        String
  description String?

  classes Class[]
  users   User[]
}

model Topic {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  slug        String   @unique
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  materials  Material[]
  games      Game[]
  quizzes    Quiz[]
  progresses TopicProgress[]
}

model Material {
  id          Int          @id @default(autoincrement())
  type        MaterialType
  content     String
  order       Int          @default(0)
  isPublished Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  topicId Int
  topic   Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, order])
}

model Class {
  id    Int    @id @default(autoincrement())
  name  String
  grade Int

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  users User[]
}

model User {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  fullName       String
  email          String   @unique
  passwordHash   String
  role           UserRole @default(USER)
  totalPoints    Float    @default(0)
  profilePicture String?
  username       String?  @unique

  schoolId Int?
  school   School? @relation(fields: [schoolId], references: [id])

  classId Int?
  class   Class? @relation(fields: [classId], references: [id])

  minigameResults    MinigameResult[]
  quizResults        QuizResult[]
  educationPostViews EducationPostView[]
  userAchievements   UserAchievement[]
  quizAttempts       QuizAttempt[]
  gameAttempts       GameAttempt[]
  topicProgresses    TopicProgress[]
}

model Minigame {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  maxPoints   Int
  isActive    Boolean @default(true)

  results MinigameResult[]
}

model MinigameResult {
  id           Int      @id @default(autoincrement())
  pointsEarned Int
  completedAt  DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  minigameId Int
  minigame   Minigame @relation(fields: [minigameId], references: [id])
}

model Quiz {
  id           Int     @id @default(autoincrement())
  name         String
  description  String
  isActive     Boolean @default(true)
  isPublished  Boolean @default(false)
  passingScore Int     @default(0)
  order        Int     @default(0)

  topicId       Int?
  topic         Topic?         @relation(fields: [topicId], references: [id])
  quizQuestions QuizQuestion[]
  results       QuizResult[]
  attempts      QuizAttempt[]

  @@index([topicId, order])
}

model Question {
  id          Int          @id @default(autoincrement())
  text        String
  type        QuestionType @default(SINGLE)
  explanation String?
  points      Int          @default(1)
  order       Int          @default(0)

  answers            Answer[]
  quizQuestions      QuizQuestion[]
  quizAttemptAnswers QuizAttemptAnswer[]
}

model Answer {
  id        Int     @id @default(autoincrement())
  text      String
  isCorrect Boolean @default(false)
  order     Int     @default(0)

  questionId Int
  question   Question @relation(fields: [questionId], references: [id])
}

model Game {
  id          Int      @id @default(autoincrement())
  title       String
  type        GameType
  config      Json?
  isPublished Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topicId Int
  topic   Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  attempts GameAttempt[]

  @@index([topicId, order])
}

model GameAttempt {
  id           Int       @id @default(autoincrement())
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  result       Json?
  pointsEarned Int       @default(0)
  isFinished   Boolean   @default(false)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  gameId Int
  game   Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([userId, gameId])
}

model QuizAttempt {
  id         Int       @id @default(autoincrement())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  score      Int       @default(0)
  maxScore   Int       @default(0)
  isFinished Boolean   @default(false)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  quizId Int
  quiz   Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  answers QuizAttemptAnswer[]

  @@index([userId, quizId])
}

model QuizAttemptAnswer {
  id          Int      @id @default(autoincrement())
  selectedIds Int[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attemptId Int
  attempt   QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model QuizQuestion {
  quizId     Int
  questionId Int

  quiz     Quiz     @relation(fields: [quizId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@id([quizId, questionId])
}

model QuizResult {
  id             Int      @id @default(autoincrement())
  correctAnswers Int
  totalQuestions Int
  completedAt    DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  quizId Int
  quiz   Quiz @relation(fields: [quizId], references: [id])
}

model EducationPost {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())

  views EducationPostView[]
}

model EducationPostView {
  id       Int      @id @default(autoincrement())
  viewedAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  postId Int
  post   EducationPost @relation(fields: [postId], references: [id])
}

model Achievement {
  id            Int     @id @default(autoincrement())
  code          String  @unique
  name          String
  description   String
  title         String?
  icon          String?
  conditionType String
  criteria      Json?
  isActive      Boolean @default(true)

  userAchievements UserAchievement[]
}

model UserAchievement {
  userId        Int
  achievementId Int
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@id([userId, achievementId])
}

model TopicProgress {
  id                    Int      @id @default(autoincrement())
  completedGamesCount   Int      @default(0)
  completedQuizzesCount Int      @default(0)
  bestQuizScore         Int      @default(0)
  totalPoints           Int      @default(0)
  updatedAt             DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  topicId Int
  topic   Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
}
